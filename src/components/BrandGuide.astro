---
import Base from '../layouts/Base.astro';
import AffLink from './AffLink.astro';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import AppCTA from './AppCTA.astro';
import { womensClothing, mensClothing } from '../config/sizeConversions';
import type { ConversionTable } from '../config/sizeConversions';
import { affiliateLinks } from '../config/affiliateLinks';

/**
 * A table rendered inline within a fitSection's prose (e.g. a fit comparison,
 * as opposed to the size conversions in the charts area). Same markup and
 * overflow treatment as the chart tables; heading is optional because these
 * tables are usually introduced by the paragraph above them.
 */
type FitSectionTable = Omit<ConversionTable, 'heading'> & {
  heading?: string;
  /**
   * Screen-reader name for the table's scroll region when there is no visible
   * heading. Lets pages with several heading-less inline tables announce each
   * one distinctly instead of all falling back to "Comparison table".
   */
  ariaLabel?: string;
};

interface FitSection {
  category: string;
  /**
   * One paragraph, or several. Rendered as HTML so body copy can carry inline
   * links; author-supplied only, never user input. An entry may also be a
   * table object, rendered between the surrounding paragraphs.
   */
  text: string | (string | FitSectionTable)[];
}

interface Faq {
  q: string;
  a: string;
}

interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  /** Key into affiliateLinks config, e.g. "uniqlo". */
  brandKey: string;
  /** Display name, e.g. "Uniqlo". */
  brand: string;
  title: string;
  description: string;
  /** Optional brand-typical measurement chart(s), clearly labeled approximate. */
  typicalCharts?: ConversionTable[];
  /**
   * Render the generic international clothing conversion tables. Defaults to
   * true so existing guides are unchanged; footwear-only guides pass false,
   * where women's/men's clothing conversions are noise rather than context.
   */
  standardCharts?: boolean;
  /** Override the generated H1 when the default question doesn't fit the brand. */
  h1?: string;
  /** Override the heading above the charts. */
  chartsHeading?: string;
  fitSections: FitSection[];
  faqs: Faq[];
  related: RelatedLink[];
  /**
   * Emit BreadcrumbList JSON-LD for this guide. The trail is fully determined
   * by where brand guides live, so there is nothing to configure: opting in is
   * the whole of the change a guide needs to make.
   */
  breadcrumbs?: boolean;
}

const {
  brandKey,
  brand,
  title,
  description,
  typicalCharts = [],
  standardCharts = true,
  h1,
  chartsHeading,
  fitSections,
  faqs,
  related,
  breadcrumbs = false,
} = Astro.props;

const breadcrumbTrail = breadcrumbs
  ? [
      { name: 'Home', href: '/' },
      { name: 'Size Guides', href: '/size-guides/' },
      { name: brand, href: Astro.url.pathname },
    ]
  : undefined;

// A guide can supply its own lead-in to the charts; otherwise the default
// copy below applies.
const hasChartsIntro = Astro.slots.has('charts-intro');

const chartLink = affiliateLinks[brandKey]?.officialSiteUrl;

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const standardTables: ConversionTable[] = standardCharts ? [womensClothing, mensClothing] : [];

const heading = h1 ?? `${brand} Size Chart & Fit Guide: Does ${brand} Run Small?`;
---

<Base title={title} description={description} ogType="article" breadcrumbs={breadcrumbTrail}>
  <article class="mx-auto max-w-article px-5 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-plum">Size Guide</p>
    <h1 class="mt-2 font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
      {heading}
    </h1>

    <AffiliateDisclosure brands={[brandKey]} />

    <div class="mt-8 rounded-xl bg-plum-light p-5">
      <p class="font-semibold text-plum">Quick verdict</p>
      <div class="mt-2 text-ink/85"><slot name="verdict" /></div>
    </div>

    {fitSections.length > 0 && (
      <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">
        How {brand} fits by category
      </h2>
    )}
    {fitSections.map((s) => (
      <>
        <h3 class="mt-6 text-lg font-semibold text-ink">{s.category}</h3>
        {(Array.isArray(s.text) ? s.text : [s.text]).map((para) =>
          typeof para === 'string' ? (
            <p class="mt-2 leading-relaxed text-ink/85" set:html={para} />
          ) : (
            <>
              {para.heading && <h4 class="mt-4 font-semibold text-ink">{para.heading}</h4>}
              {para.note && !para.noteAfter && <p class="mt-1 text-sm text-smoke">{para.note}</p>}
              <div
                class="mt-3 overflow-x-auto rounded-xl border border-ink/10"
                tabindex="0"
                role="region"
                aria-label={para.ariaLabel ?? para.heading ?? 'Comparison table'}
              >
                <table
                  class="w-full border-collapse bg-white/70 text-sm"
                  style={`min-width:${para.minWidth ?? 560}px`}
                >
                  <thead>
                    <tr class="bg-plum text-left text-white">
                      {para.headers.map((h) => (
                        <th scope="col" class="px-4 py-3 font-semibold">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {para.rows.map((row) => (
                      <tr class="border-t border-ink/10">
                        {row.map((cell, i) =>
                          i === 0 ? (
                            <th scope="row" class="px-4 py-3 text-left font-semibold">{cell}</th>
                          ) : (
                            <td class="px-4 py-3 text-smoke">{cell}</td>
                          )
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {para.note && para.noteAfter && <p class="mt-2 text-sm text-smoke">{para.note}</p>}
            </>
          )
        )}
      </>
    ))}

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">
      {chartsHeading ?? 'Size conversion charts'}
    </h2>
    {hasChartsIntro ? (
      <slot name="charts-intro" />
    ) : standardCharts ? (
      <p class="mt-3 leading-relaxed text-ink/85">
        The tables below are <strong>standard international conversions</strong>, not {brand}-specific
        garment measurements. Cuts and fabrics vary between styles, so
        <AffLink brand={brandKey} href={chartLink}
          >check {brand}'s official size chart for exact garment measurements</AffLink
        > before you order.
      </p>
    ) : (
      <p class="mt-3 leading-relaxed text-ink/85">
        Fit varies between styles, so
        <AffLink brand={brandKey} href={chartLink}>check {brand}'s official size chart</AffLink>
        before you order.
      </p>
    )}

    {[...standardTables, ...typicalCharts].map((c) => (
      <>
        <h3 class="mt-8 text-lg font-semibold text-ink">{c.heading}</h3>
        {c.note && !c.noteAfter && <p class="mt-1 text-sm text-smoke">{c.note}</p>}
        <div
          class="mt-3 overflow-x-auto rounded-xl border border-ink/10"
          tabindex="0"
          role="region"
          aria-label={c.heading}
        >
          <table
            class="w-full border-collapse bg-white/70 text-sm"
            style={`min-width:${c.minWidth ?? 560}px`}
          >
            <thead>
              <tr class="bg-plum text-left text-white">
                {c.headers.map((h) => (
                  <th scope="col" class="px-4 py-3 font-semibold">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {c.rows.map((row) => (
                <tr class="border-t border-ink/10">
                  {row.map((cell, i) =>
                    i === 0 ? (
                      <th scope="row" class="px-4 py-3 text-left font-semibold">{cell}</th>
                    ) : (
                      <td class="px-4 py-3 text-smoke">{cell}</td>
                    )
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {c.note && c.noteAfter && <p class="mt-2 text-sm text-smoke">{c.note}</p>}
      </>
    ))}

    <slot name="charts-outro" />


    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">
      How to choose your size at {brand}
    </h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-ink/85">
      <slot name="tips" />
    </ul>

    {faqs.length > 0 && (
      <>
        <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">
          {brand} sizing FAQ
        </h2>
        <div class="mt-4 space-y-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-ink/10 bg-white/60 p-5">
              <h3 class="font-semibold text-ink">{f.q}</h3>
              <p class="mt-2 leading-relaxed text-ink/85">{f.a}</p>
            </div>
          ))}
        </div>
      </>
    )}

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">Keep reading</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5">
      {related.map((r) => (
        <li>
          <a href={r.href} class="font-semibold text-plum underline decoration-plum/40 underline-offset-2 hover:decoration-plum">{r.label}</a>
        </li>
      ))}
      <li>
        <a href="/size-guides/international-size-conversion/" class="font-semibold text-plum underline decoration-plum/40 underline-offset-2 hover:decoration-plum">International size conversion charts</a>
      </li>
      <li>
        <a href="/how-to-measure/" class="font-semibold text-plum underline decoration-plum/40 underline-offset-2 hover:decoration-plum">How to measure yourself at home</a>
      </li>
    </ul>

    <AppCTA brand={brand} />
  </article>

  {faqs.length > 0 && <script type="application/ld+json" set:html={faqJsonLd} is:inline />}
</Base>
