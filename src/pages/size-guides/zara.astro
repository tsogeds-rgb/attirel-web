---
import BrandGuide from '../../components/BrandGuide.astro';
import type { ConversionTable } from '../../config/sizeConversions';

const charts: ConversionTable[] = [
  {
    heading: 'Zara women’s',
    minWidth: 640,
    headers: ['Size', 'US', 'UK', 'EU', 'Bust', 'Waist', 'Hips'],
    rows: [
      ['XS', '0–2', '4–6', '34', '31.5"', '24.5"', '34.5"'],
      ['S', '4', '8', '36', '33"', '26"', '36"'],
      ['M', '6', '10', '38', '34.5"', '27.5"', '37.5"'],
      ['L', '8–10', '12', '40', '36.5"', '29.5"', '39.5"'],
      ['XL', '12', '14', '42', '38.5"', '31.5"', '41.5"'],
    ],
  },
  {
    heading: 'Zara men’s',
    headers: ['Size', 'US/UK', 'EU', 'Chest', 'Waist'],
    rows: [
      ['S', '36–38', '46', '35–37"', '29–31"'],
      ['M', '38–40', '48', '37–39"', '31–33"'],
      ['L', '40–42', '50', '39–41"', '33–35"'],
