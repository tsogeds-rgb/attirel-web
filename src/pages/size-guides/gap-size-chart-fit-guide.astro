];

const faqs = [
  {
    q: 'Does Gap run small?',
    a: "No. Gap's published measurements sit close to standard US sizing, and the brand is generally accurate to its own chart. The complaint that Gap runs small usually comes from bottoms above size 10, where the number on the label drifts below the actual waist measurement, so a shopper ordering by label gets something tighter than expected.",
  },
  {
    q: 'Is Gap petite sized differently through the body, or just shorter?',
    a: "For tops, just shorter. Gap's petite chart lists identical bust and waist measurements to the regular chart at every size from 000 to 22, and differs only in sleeve length, by a constant inch and a half. Bottoms are different: petite there is a 29 inch inseam against a 31½ inch regular, and that is a genuine length change.",
  },
  {
    q: "What is my Gap size in men's if I usually buy women's?",
    a: "For tops, take two sizes down: a women's L is a men's M. For bottoms, Gap publishes two charts that disagree by one size, so go by the waist measurement instead. Match your measured waist to the men's waist column and disregard the letter.",
  },
  {
    q: 'Does my jean number equal my waist in inches?',
    a: 'Only up to size 10. Through 10/30 your body waist runs about half an inch above the jean number. From 12/31 the two separate, and by 22/36 the label understates the waist by five and a half inches.',
  },
  {
    q: 'What inseam lengths does Gap offer?',
    a: "Women's bottoms come in five: petite 29 inches, short 30, regular 31½, long 33½, and tall 35½. Men's bottoms come in two: regular 32 inches and tall 36.",
  },
  {
    q: 'How do I convert my Gap size to UK or EU?',
    a: "Gap labels in US sizes and does not publish UK or EU conversions on its women's or men's apparel charts. The conversion columns appear only on the kids' and accessories charts, where the EU column duplicates the US column exactly and carries no information.",
  },
  {
    q: "Should I trust Gap's accessories size charts?",
    a: `Less than the apparel ones. The women's hat chart's inch and centimetre figures do not convert to each other, gloves are measured as "width" for women and "circumference" for men, and the women's belt chart's waist figures do not correspond to any size in Gap's clothing range.`,
  },
];

const related = [
  { href: '/size-guides/levis-size-chart-fit-guide/', label: "Levi's size chart & fit guide" },
  { href: '/blog/vanity-sizing-explained/', label: 'Vanity sizing, explained' },
  {
    href: '/blog/petite-vs-regular-vs-tall/',
    label: 'Petite vs. regular vs. tall, explained',
  },
];
---

<BrandGuide
  brandKey="gap"
  brand="Gap"
  title="Gap Size Chart & Fit Guide: Does Gap Run Small?"
  description="Gap's own charts disagree on unisex bottoms, petite only changes sleeve length, and the jean number stops tracking your waist above size 10."
  chartsHeading="The charts"
  standardCharts={false}
  typicalCharts={charts}
  fitSections={fitSections}
  faqs={faqs}
  related={related}
>
  <Fragment slot="verdict">
    <p>Four rules cover almost everything:</p>
    <ol class="mt-3 list-decimal space-y-2 pl-5">
      <li>
        <strong>Measure, then use the chart, not the label.</strong> Gap's size names are stable
        across tops and bottoms, but the numbers printed on bottoms drift from your body above size
        10.
      </li>
      <li>
        <strong>Treat petite and tall as sleeve length.</strong> For tops they change nothing else.
        For bottoms, use the five inseam options, which are real.
      </li>
      <li>
        <strong>For unisex bottoms, match the waist measurement, not the letter.</strong> Gap's two
        charts disagree by a full size on the letter, and agree on the inches.
      </li>
      <li>
        <strong>Check the product page for anything the chart calls a range.</strong> Men's tops and
        bottoms are published as ranges rather than points, so a mid-range body can land either side
        depending on cut.
      </li>
    </ol>
  </Fragment>

  <Fragment slot="charts-intro">
    <p class="mt-3 leading-relaxed text-ink/85">
      Every measurement on this page comes from <AffLink brand="gap"
        href="https://www.gap.com/customer-service/size-charts?cid=2103"
        >Gap's published size chart modals</AffLink
      >, captured August 2026. These are Gap's own figures, not standard international conversions:
      Gap labels in US sizes and publishes no UK or EU conversion for adult apparel, so what follows
      is Gap's chart data rather than a conversion reference.
    </p>
  </Fragment>

  <Fragment slot="charts-outro">
    <p class="mt-6 leading-relaxed text-ink/85">
      Measure over underwear or thin clothing with a soft tape, and take the waist at the narrowest
      point. Our <a href="/how-to-measure/" class={linkClass}>measuring guide</a> covers the method
      in a few minutes.
    </p>
  </Fragment>

  <Fragment slot="tips">
    <li>
      <strong>Order bottoms by measured waist, not by the label:</strong> the jean number and your
      body agree within half an inch through size 10, then drift apart by up to five and a half
      inches at 22/36.
    </li>
    <li>
      <strong>Pick petite or tall for your arms, not your torso:</strong> in tops, both variants
      keep bust and waist identical to regular and move only the sleeve. If your bust or waist sits
      between sizes, the variant tabs solve nothing.
    </li>
    <li>
      <strong>Use the inseam options before you tailor:</strong> women's bottoms come in five
      lengths from 29" to 35½". Men get 32" or 36" and nothing between.
    </li>
    <li>
      <strong>Buying across genders, trust inches over letters:</strong> the two unisex charts
      disagree by a full size on the letter and agree on the waist measurement.
    </li>
    <li>
      <strong>Treat accessories charts as suggestions:</strong> the hat, glove, and belt figures
      contain internal contradictions of their own. Measure and compare against the product page
      instead.
    </li>
  </Fragment>
</BrandGuide>
