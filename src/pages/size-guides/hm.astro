const faqs = [
  {
    q: 'Does H&M run small?',
    a: 'Not by its chart. H&M’s published bands are standard for a European high-street brand, and the measurements above are generous rather than tight: a US 8 covers a 74–78 cm (29–30¾ in) waist. What reads as “small” is usually the Divided line, which is cut for a younger, slimmer frame, or a slim-fit style within a letter band that is 8–11 cm wide. Buy from your measurement, not from the size you wear at another brand.',
  },
  {
    q: 'Where is H&M’s size chart? I can’t find it on the US site.',
    a: 'There is no standalone size-guide page on hm.com/en_us. The chart is behind the “Size guide” link on every product page, and it is the same brand-wide table on every product in a category. The tables on this page are transcribed from that drawer.',
  },
  {
    q: 'Which H&M size am I if my waist and hip land in different letters?',
    a: 'For a top or dress, chest decides first, then hip; for a jumpsuit or anything fitted through the hip, go with the hip and expect the waist to be roomy. For bottoms you don’t have to choose: each numeric size has its own waist and hip row, so pick the size whose waist contains yours and check its hip. If your hip reads a full size smaller than your waist, look at the petite tab, which keeps the waist and trims the hip.',
  },
  {
    q: 'What is the difference between H&M Regular and Long in men’s trousers?',
    a: 'Only the inside leg: Long is 4 cm longer at every size, with the same waist and low hip. Choose the waist number from your measurement, then R if your inseam is under about 84 cm (33 in) and L if it is over about 86 cm (34 in).',
  },
  {
    q: 'How do H&M EUR sizes convert to US?',
    a: 'For women’s letter sizes, each letter spans two EUR sizes (M is EUR 40–42, US 8–10). Women’s numeric bottoms are EUR = US + 32. Men’s tops are EUR = US + 10 (US 42 chest = EUR 52); men’s trousers are EUR = US + 14 (US 32 waist = EUR 46).',
  },
];

const related = [
  { href: '/size-guides/uniqlo-size-chart-fit-guide/', label: 'Uniqlo size chart & fit guide' },
  { href: '/size-guides/zara/', label: 'Zara size guide' },
  { href: '/size-guides/gap-size-chart-fit-guide/', label: 'Gap size chart & fit guide' },
  { href: '/how-to-measure/', label: 'How to measure yourself' },
];
---

<BrandGuide
  brandKey="hm"
  brand="H&M"
  title="H&M Size Chart & Fit Guide: Women’s, Men’s and Shoes in cm | Attirel"
  description="H&M’s own size chart in centimetres, transcribed from the US site: women’s XXS–4XL and jeans 0–30, men’s XS–3XL and trousers 26–50 in R and L, shoes. What petite changes, where the letter bands are wide, and how to read it."
  h1="H&M Size Chart & Fit Guide"
  standardCharts={false}
  chartsHeading="H&M’s size charts, in centimetres"
  typicalCharts={charts}
  fitSections={fitSections}
  fitSectionsHeading="How H&M’s chart actually works"
  faqs={faqs}
  related={related}
  breadcrumbs
>
  <Fragment slot="verdict">
    <p>
      H&amp;M's chart is honest and wide. Letter sizes span 8–11 cm at the waist, so "true to
      size" depends on where in the band you land; numeric jeans and trousers have a row per
      size and are far easier to get right. Measure in centimetres and read the centimetre row
      — the inch rows are rounded and in two places don't match.
    </p>
  </Fragment>
  <Fragment slot="method">
    <ol class="mt-3 list-decimal space-y-2 pl-5">
      <li>
        <strong>Measure chest, waist and low hip in centimetres.</strong> H&amp;M measures the hip
        at its widest point (the "low hip"), not at the hip bone. Our <a
          href="/how-to-measure/"
          class={linkClass}>measuring guide</a
        > shows where.
      </li>
      <li>
        <strong>For tops and dresses, find the letter whose chest band contains you,</strong> then
        check that your waist and hip fall in the same band. If they don't, the garment's cut
        decides which one matters: a shirt is bought on chest, a fitted dress on hip.
      </li>
      <li>
        <strong>For jeans and trousers, use the numeric chart</strong> and pick the size whose waist
        range contains yours. Men: then choose R or L from your inseam.
      </li>
      <li>
        <strong>If your hip reads a size smaller than your waist, check petite</strong> — it
        keeps the regular waist and takes 3–4 cm off the hip.
      </li>
      <li>
        <strong>Shoes: go by foot length in centimetres</strong> and round up if you are between
        sizes; women's have no half sizes.
      </li>
    </ol>
  </Fragment>
  <Fragment slot="charts-intro">
    <p class="mt-3 leading-relaxed text-ink/85">
      Every figure below is H&amp;M's own, transcribed on 12 November 2026 from the size-guide
      drawer on <AffLink brand="hm" href="https://www2.hm.com/en_us/">hm.com's US product
        pages</AffLink
      >, which show the same brand-wide table on every product in a category. We load only
      the centimetre rows, because the inch rows are H&amp;M's rounded conversions and do not
      always agree with them. Petite, maternity and the men's Long-sleeve tab are described in
      the sections above rather than tabulated. These same figures are what <a
        href="https://www.attirel.ai/size-check"
        class={linkClass}>Attirel's size check</a
      > reads when it names your H&amp;M size.
    </p>
  </Fragment>
  <Fragment slot="tips">
    <li><strong>Read the centimetre row.</strong> H&amp;M drafts in cm; the inches are conversions and two of them don't match the centimetres.</li>
    <li><strong>Letter sizes are bands, not points.</strong> An M waist is 74–82.5 cm. If you are at the top of a band and the style is slim, the next size up is not sizing up — it's the same chart read honestly.</li>
    <li><strong>Jeans by number, not letter.</strong> Each numeric size has its own waist and hip; use that chart even when the product also lists a letter.</li>
    <li><strong>Divided:</strong> H&amp;M's younger-fashion line is cut slimmer than the main range. The published chart does not change, so treat the top of each band as the realistic limit.</li>
    <li><strong>Petite is a hip and length change</strong>, not a smaller waist. Consider it if your hip sits a size below your waist.</li>
    <li><strong>Men's R / L:</strong> same waist, 4 cm of leg. Under 84 cm inseam, R; over 86, L.</li>
    <li><strong>Shoes:</strong> no women's half sizes and a patchy men's ladder, so measure your foot and pick from the cm column.</li>
  </Fragment>
</BrandGuide>
