---
import BrandGuide from '../../components/BrandGuide.astro';
import AffLink from '../../components/AffLink.astro';
import type { ConversionTable } from '../../config/sizeConversions';

const charts: ConversionTable[] = [
  {
    heading: 'H&M women’s',
    note: 'H&M states single-point centimetre values, two EUR sizes per letter; the inch figures are converted from those. The chart continues to 4XL (EUR 60 / 62). The gaps between letters (for example bust 96 to 100 cm between M and L) are inherent to H&M’s chart, not omissions.',
    noteAfter: true,
    minWidth: 860,
    headers: ['Size', 'EUR', 'US', 'UK', 'Bust', 'Waist', 'Seat'],
    rows: [
      ['XS', '32 / 34', '2 / 4', '6 / 8', '76 / 80 cm (29.9 / 31.5")', '60 / 64 cm (23.6 / 25.2")', '84 / 88 cm (33.1 / 34.6")'],
      ['S', '36 / 38', '6 / 8', '10 / 12', '84 / 88 cm (33.1 / 34.6")', '68 / 72 cm (26.8 / 28.3")', '92 / 96 cm (36.2 / 37.8")'],
      ['M', '40 / 42', '10 / 12', '14 / 16', '92 / 96 cm (36.2 / 37.8")', '76 / 80 cm (29.9 / 31.5")', '100 / 104 cm (39.4 / 40.9")'],
      ['L', '44 / 46', '14 / 16', '18 / 20', '100 / 104 cm (39.4 / 40.9")', '84 / 88 cm (33.1 / 34.6")', '108 / 112 cm (42.5 / 44.1")'],
      ['XL', '48 / 50', '18 / 20', '22 / 24', '110 / 116 cm (43.3 / 45.7")', '94 / 100 cm (37.0 / 39.4")', '117 / 122 cm (46.1 / 48.0")'],
      ['2XL', '52 / 54', '22 / 24', '26 / 28', '122 / 128 cm (48.0 / 50.4")', '106 / 112 cm (41.7 / 44.1")', '127 / 132 cm (50.0 / 52.0")'],
    ],
  },
  {
    heading: 'H&M men’s',
    headers: ['Size', 'US/UK', 'EU', 'Chest', 'Waist'],
    rows: [
      ['XS', '32–34', '42–44', '32–34"', '26–28"'],
      ['S', '34–36', '44–46', '34–36"', '28–30"'],
      ['M', '38–40', '48–50', '38–40"', '32–33"'],
      ['L', '42–44', '52–54', '42–44"', '34–36"'],
      ['XL', '46–48', '56–58', '46–48"', '38–40"'],
    ],
  },
];
---

<BrandGuide
  brandKey="hm"
  brand="H&M"
  title="H&M Size Guide — Is H&M True to Size? (Charts & Tips) | Attirel"
  description="H&M is generally true to size with a standard European fit. Full H&M size charts for women and men with US, UK, and EU conversions, plus fitting tips."
  h1="H&M Size Guide"
  standardCharts={false}
  typicalCharts={charts}
  fitSections={[]}
  faqs={[]}
  related={[]}
>
  <Fragment slot="verdict">
    <strong>Mostly yes — H&amp;M is generally true to size</strong> with a standard European
    fit. Basics and everyday lines fit as labelled for most shoppers. The main caveats: the
    Divided (youth) line runs a size small, and some fashion-line pieces cut slimmer than the
    basics, so check the product page's fit notes.
  </Fragment>
  <Fragment slot="charts-intro">
    <p class="mt-3 leading-relaxed text-ink/85">
      The women's chart below is drawn from <AffLink
        brand="hm"
        href="https://www.hm.com/xk/customer-service/sizeguide/ladies/"
        >H&amp;M's published size guide on its Kosovo regional site</AffLink
      > (captured August 2026), which still hosts the full tables and states centimetre values;
      the inches are converted from those. H&amp;M's US and Canadian sites no longer publish a
      brand-level size guide and instead direct shoppers to the measurements on each product page.
      The men's chart predates that verification and keeps its original figures pending the same
      check. Fit still varies between styles, so check the size guide on the product page before
      you order.
    </p>
  </Fragment>
  <Fragment slot="tips">
    <li><strong>Divided line:</strong> H&amp;M's youth-oriented line runs about one size small, so size up.</li>
    <li><strong>UK vs US women's:</strong> UK sizes run numerically 4 higher (US 8 = UK 12); the EU label is usually the most reliable reference.</li>
    <li><strong>Knitwear and jersey basics:</strong> tend to relax with wear; stay true to size rather than sizing up.</li>
    <li><strong>Denim:</strong> H&amp;M jeans use waist measurements in inches on many lines. Match your natural waist measurement directly.</li>
    <li><strong>One inseam for every size:</strong> H&amp;M's main women's range lists a fixed 79 cm (31.1") inside leg from XS through 4XL, with no length variation.</li>
    <li><strong>Petite is length-only:</strong> H&amp;M bases petite on height, not width: use the regular guide's width measurements and expect a fixed 73 cm (28.7") inside leg. That is the same structure Gap's petite tops show, documented in our <a href="/size-guides/gap-size-chart-fit-guide/" class="font-semibold text-plum underline decoration-plum/40 underline-offset-2 hover:decoration-plum">Gap fit guide</a>: the variant changes length, not width.</li>
  </Fragment>
</BrandGuide>
