---
import BrandGuide from '../../components/BrandGuide.astro';
import AffLink from '../../components/AffLink.astro';
import type { ConversionTable } from '../../config/sizeConversions';

const linkClass =
  'font-semibold text-plum underline decoration-plum/40 underline-offset-2 hover:decoration-plum';

const fitSections = [
  {
    category: 'One body chart for every letter-sized women’s garment',
    text: [
      `H&amp;M's US site has no standalone size-guide page, which is why so many guides (ours included, until November 2026) rebuilt it from regional sites. But the <strong>Size guide</strong> link on every product page opens a brand-wide chart, not a per-product one: open it on a sequined top, a plain black shirt and a quilted vest and you get the same table, cell for cell. Tops, blouses, jackets and dresses all share a single chest / waist / low-hip chart, XXS to 4XL. Dresses add one row for inside-leg length (for jumpsuits); everything else is identical.`,
      `The chart is drafted in centimetres. The inch rows are rounded conversions and they don't always agree with each other: the XXL low hip reads 47½–50½ in while its centimetre range (120.5–131) converts to 47½–51½, and 3XL picks up at 51½. Measure in centimetres and read the centimetre row; the inches are a courtesy.`,
      `The letter bands are wide. S covers a 66–74 cm waist, M 74–82.5, L 82.5–93, so a letter size is a band of 8–11 cm, and two body shapes that both "are a Medium" can be nearly a full size apart in the fabric. The bands also touch rather than overlap — 74 is the top of S and the bottom of M — so if your waist sits exactly on a boundary, your chest or hip decides.`,
    ],
  },
  {
    category: 'Women’s bottoms are numeric, and each size has its own row',
    text: [
      `Jeans and trousers use US numeric sizes 0 to 30 (EUR 32 to 62), and unlike the letter chart every size gets its own waist, low hip and inside-leg figure. That makes bottoms the easiest H&amp;M category to size from a tape measure: a 74–78 cm waist is a size 8, no interpretation needed. The grade is 4 cm per size up to size 10 and widens to 5–7 cm from size 12 up.`,
      `Inside leg is one number per size, not a length choice — 76–78 cm (about 30–30¾ in) in the regular range, drifting slightly shorter as sizes go up. If you need a shorter leg, that is what the petite tab is for; there is no tall tab on the US site.`,
    ],
  },
  {
    category: 'Petite changes the hip and the leg, not the waist',
    text: [
      `H&amp;M's petite tab is not just "shorter". Chest and waist match the regular chart almost exactly (XXS/P chest starts at 74 cm rather than 75; everything else is identical), but the <strong>low hip is 3–4 cm smaller at every size</strong> and the inside leg drops from 76–78 cm to 71–73 cm. So a petite 8 is a regular 8 at the waist, a slightly smaller hip, and about 5 cm less leg. If your waist fits the regular chart but your hip reads a size down, petite may be the better match even at average height.`,
      `Maternity drops the waist row and keeps the regular chest and hip figures.`,
    ],
  },
  {
    category: 'Men’s trousers come in two lengths with the same waist',
    text: [
      `Men's trousers are numeric 26 to 50 (plus a 33), and H&amp;M's size selector labels each one <strong>R</strong> or <strong>L</strong> — 32R, 32L. The Regular and Long tabs of the size guide have identical waist and low-hip rows; only inside leg changes, by exactly 4 cm at every size (R 80.5–85.5 cm, L 84.5–89.5 cm). Pick the waist from your measurement, then the letter from your inseam: under about 84 cm, R; over about 86 cm, L; between, either.`,
      `Men's letter sizes (XS–3XL) map onto the numeric grid two sizes per letter: M is 38–40, L is 42–44, and so on. EUR trouser sizes are US + 14; EUR top sizes are US + 10.`,
    ],
  },
  {
    category: 'Men’s tops: the Long tab is arm length only',
    text: [
      `Shirts, T-shirts, jackets and blazers share one chart, XS to 3XL, with chest, waist, arm length and neckline. The Regular and Long tabs have the same chest, waist and neck; Long adds 3 cm of sleeve. Chest bands are 8 cm wide (M is 94–102 cm) and the waist bands widen with size, from 8 cm at XS to 9 cm at L and above.`,
    ],
  },
  {
    category: 'Shoes: whole sizes for women, a thinned ladder for men',
    text: [
      `Women's shoes run 3 to 11 in whole sizes only — no halves — with a 0.6–0.7 cm step between each (US 7 is 24.3 cm, US 8 is 25.0). If your foot lands between two sizes you are choosing between about 3 mm short and 3 mm long, so measure carefully and lean long.`,
      `Men's shoes run 6 to 13 but skip 6.5, 8, 9.5, 11 and 12.5, so the ladder is 6, 7, 7.5, 8.5, 9, 10, 10.5, 11.5, 12, 13 — a mix of whole and half steps that doesn't follow a pattern. Go by the centimetre figure on the product page rather than by the size you wear elsewhere.`,
    ],
  },
];

const cm = (lo: number, hi?: number) => (hi === undefined ? `${lo} cm` : `${lo}–${hi} cm`);

