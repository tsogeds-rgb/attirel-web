---
import Base from '../../layouts/Base.astro';

const womens = [
  ['XS', '0–2', '4–6', '32–34', '30–32"', '24–26"', '33–35"'],
  ['S', '4–6', '8–10', '36–38', '33–35"', '27–29"', '36–38"'],
  ['M', '8–10', '12–14', '40–42', '36–38"', '30–32"', '39–41"'],
  ['L', '12–14', '16–18', '44–46', '40–42"', '34–36"', '43–45"'],
  ['XL', '16–18', '20–22', '48–50', '44–46"', '38–41"', '46–48"'],
];

const mens = [
  ['XS', '32–34', '42–44', '32–34"', '26–28"'],
  ['S', '34–36', '44–46', '34–36"', '28–30"'],
  ['M', '38–40', '48–50', '38–40"', '32–33"'],
  ['L', '42–44', '52–54', '42–44"', '34–36"'],
  ['XL', '46–48', '56–58', '46–48"', '38–40"'],
];
---

<Base
  title="H&M Size Guide — Is H&M True to Size? (Charts & Tips) | Attirel"
  description="H&M is generally true to size with a standard European fit. Full H&M size charts for women and men with US, UK, and EU conversions, plus fitting tips."
  ogType="article"
>
  <article class="mx-auto max-w-article px-5 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-plum">Size Guide</p>
    <h1 class="mt-2 font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
      H&amp;M Size Guide
    </h1>

    <div class="mt-8 rounded-xl bg-plum-light p-5">
      <p class="font-semibold text-plum">Is H&amp;M true to size?</p>
      <p class="mt-2 text-ink/85">
        <strong>Mostly yes — H&amp;M is generally true to size</strong> with a standard European
        fit. Basics and everyday lines fit as labelled for most shoppers. The main caveats:
        the Divided (youth) line runs a size small, and some fashion-line pieces cut slimmer
        than the basics — check the product page’s fit notes.
      </p>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">H&amp;M women’s</h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-ink/10">
      <table class="w-full min-w-[640px] border-collapse bg-white/70 text-sm">
        <thead>
          <tr class="bg-plum text-left text-white">
            <th class="px-4 py-3 font-semibold">Size</th>
            <th class="px-4 py-3 font-semibold">US</th>
            <th class="px-4 py-3 font-semibold">UK</th>
            <th class="px-4 py-3 font-semibold">EU</th>
            <th class="px-4 py-3 font-semibold">Bust</th>
            <th class="px-4 py-3 font-semibold">Waist</th>
            <th class="px-4 py-3 font-semibold">Hips</th>
          </tr>
        </thead>
        <tbody>
          {womens.map((row) => (
            <tr class="border-t border-ink/10">
              {row.map((cell, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'font-semibold' : 'text-smoke'}`}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">H&amp;M men’s</h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-ink/10">
      <table class="w-full min-w-[560px] border-collapse bg-white/70 text-sm">
        <thead>
          <tr class="bg-plum text-left text-white">
            <th class="px-4 py-3 font-semibold">Size</th>
            <th class="px-4 py-3 font-semibold">US/UK</th>
            <th class="px-4 py-3 font-semibold">EU</th>
            <th class="px-4 py-3 font-semibold">Chest</th>
            <th class="px-4 py-3 font-semibold">Waist</th>
          </tr>
        </thead>
        <tbody>
          {mens.map((row) => (
            <tr class="border-t border-ink/10">
              {row.map((cell, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'font-semibold' : 'text-smoke'}`}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">Conversion &amp; fitting tips</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-ink/85">
      <li><strong>Divided line:</strong> H&amp;M’s youth-oriented line runs about one size small — size up.</li>
      <li><strong>UK vs US women’s:</strong> UK sizes run numerically 4 higher (US 8 = UK 12); the EU label is usually the most reliable reference.</li>
      <li><strong>Knitwear and jersey basics:</strong> tend to relax with wear — stay true to size rather than sizing up.</li>
      <li><strong>Denim:</strong> H&amp;M jeans use waist measurements in inches on many lines — match your natural waist measurement directly.</li>
    </ul>

    <div class="mt-12 rounded-3xl bg-plum px-8 py-12 text-center text-white">
      <h2 class="font-display text-2xl font-semibold">One profile. Every brand.</h2>
      <p class="mx-auto mt-3 max-w-md text-white/80">
        Attirel adjusts for H&amp;M’s sizing automatically — your measurements in, the right
        H&amp;M size out.
      </p>
      <a
        href="https://attirel.ai"
        class="mt-6 inline-block rounded-full bg-white px-8 py-3 font-semibold text-plum transition-opacity hover:opacity-90"
      >
        Try it at attirel.ai →
      </a>
    </div>
  </article>
</Base>
