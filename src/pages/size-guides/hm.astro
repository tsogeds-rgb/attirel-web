      ['30', '44', cm(74, 78), cm(91.5, 94.5), cm(81.5), cm(85.5)],
      ['32', '46', cm(78, 82), cm(94.5, 97.5), cm(82), cm(86)],
      ['33', '48', cm(82, 86), cm(97.5, 100.5), cm(82.5), cm(86.5)],
      ['34', '50', cm(86, 90), cm(100.5, 103.5), cm(83), cm(87)],
