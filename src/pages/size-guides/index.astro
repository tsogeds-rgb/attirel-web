---
import Base from '../../layouts/Base.astro';

interface GuideCard {
  href: string;
  brand: string;
  verdict: string;
  body: string;
}

const brandGuides: GuideCard[] = [
  {
    href: '/size-guides/uniqlo-size-chart-fit-guide/',
    brand: 'Uniqlo',
    verdict: 'Tends to run small',
    body: 'Slim Japanese fit with shorter sleeves and torsos; most Western shoppers size up one.',
  },
  {
    href: '/size-guides/levis-size-chart-fit-guide/',
    brand: "Levi's",
    verdict: 'True to size (stretch)',
    body: 'Modern stretch fits match your real waist; rigid and Shrink-to-Fit classics need sizing up.',
  },
  {
    href: '/size-guides/adidas-size-chart-fit-guide/',
    brand: 'Adidas',
    verdict: 'Shoes tend to run big',
    body: 'Originals run about a half size large, so many size down. Apparel varies by line.',
  },
  {
    href: '/size-guides/gap-size-chart-fit-guide/',
    brand: 'Gap',
    verdict: 'True to its chart',
    body: 'Accurate to its own chart, but the jean number stops tracking your waist above size 10, and petite is a sleeve length.',
  },
  {
    href: '/size-guides/shein-size-chart-fit-guide/',
    brand: 'Shein',
    verdict: 'Tends to run small',
    body: 'Small-running and famously inconsistent. The garment measurements decide, not the label.',
  },
  {
    href: '/size-guides/lululemon-size-chart-fit-guide/',
    brand: 'Lululemon',
    verdict: 'Snug by design',
    body: 'Numeric sizing and compression fits, so sizing up costs you the compression.',
  },
  {
    href: '/size-guides/mango-size-chart-fit-guide/',
    brand: 'Mango',
    verdict: 'Tends to run small',
    body: 'A slim European block in the Zara family; many US shoppers go up a size.',
  },
  {
    href: '/size-guides/asos-size-chart-fit-guide/',
    brand: 'ASOS',
    verdict: 'True to size (own brand)',
    body: 'ASOS DESIGN fits true on a UK block, but the 850+ brands it stocks each fit their own way.',
  },
  {
    href: '/size-guides/nike/',
    brand: 'Nike',
    verdict: 'Runs ~half a size small',
    body: 'Footwear runs about half a size small and apparel cuts athletic-slim. Charts and tips inside.',
  },
  {
    href: '/size-guides/zara/',
    brand: 'Zara',
    verdict: 'Runs small / slim cut',
    body: 'A slim European cut that has most shoppers sizing up. No brand chart exists: Zara states measurements per garment.',
  },
  {
    href: '/size-guides/hm/',
    brand: 'H&M',
    verdict: 'True to size',
    body: 'Generally true to size with a standard European fit, but watch the Divided line. Full charts inside.',
  },
  {
    href: '/size-guides/skechers-size-chart-fit-guide/',
    brand: 'Skechers',
    verdict: 'Depends on the line',
    body: 'Not one fit but a dozen lasts. Width, footbed, and closure decide your size more than the number.',
  },
  {
    href: '/size-guides/old-navy-size-chart-fit-guide/',
    brand: 'Old Navy',
    verdict: 'Read the chart, not the label',
    body: 'Fifteen charts copied from two blocks, petite and tall identical to regular, and five whole-inch waists with no size at all.',
  },
];

const referenceGuides: GuideCard[] = [
  {
    href: '/size-guides/international-size-conversion/',
    brand: 'International Size Conversion',
    verdict: 'Master reference',
    body: 'The US ↔ UK ↔ EU ↔ AU ↔ JP conversion charts for clothing and shoes, in one place.',
  },
  {
    href: '/size-guides/bra-size-calculator-guide/',
    brand: 'Bra Size Guide',
    verdict: 'Band, cup & sister sizes',
    body: 'How band and cup sizing actually works, with a worked example and US/UK/EU differences.',
  },
  {
    href: '/size-guides/jeans-inseam-length-guide/',
    brand: 'Jeans Inseam & Length',
    verdict: 'Inseam by height',
    body: 'Typical inseams by height, petite/regular/tall explained, and how to measure your own.',
  },
];
---

<Base
  title="Size Guides: Brand Fit Charts & Sizing References"
  description="Free size guides for Uniqlo, Levi's, Adidas, Shein, Lululemon and more, plus international conversions, bra sizing, and inseam lengths."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
      The size guide library
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-smoke">
      Straight answers about how brands really fit: does it run small, when to size up, and how
      to convert between systems. New here? Start with the
      <a href="/blog/introducing-attirel-size-guide-library/" class="font-semibold text-plum underline decoration-plum/40 underline-offset-2 hover:decoration-plum">launch announcement</a>.
    </p>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">Brand fit guides</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {brandGuides.map((g) => (
        <a
          href={g.href}
          class="group rounded-2xl border border-ink/10 bg-white/60 p-7 transition-all hover:border-plum/40 hover:shadow-sm"
        >
          <h3 class="font-display text-2xl font-semibold group-hover:text-plum">{g.brand}</h3>
          <p class="mt-1 inline-block rounded-full bg-plum-light px-3 py-1 text-xs font-semibold text-plum">
            {g.verdict}
          </p>
          <p class="mt-3 text-sm text-smoke">{g.body}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-plum">View size guide →</span>
        </a>
      ))}
    </div>

    <h2 class="mt-14 font-display text-2xl font-semibold tracking-tight">Reference guides</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {referenceGuides.map((g) => (
        <a
          href={g.href}
          class="group rounded-2xl border border-plum/20 bg-plum-light p-7 transition-all hover:border-plum/40 hover:shadow-sm"
        >
          <h3 class="font-display text-2xl font-semibold group-hover:text-plum">{g.brand}</h3>
          <p class="mt-1 inline-block rounded-full bg-white/70 px-3 py-1 text-xs font-semibold text-plum">
            {g.verdict}
          </p>
          <p class="mt-3 text-sm text-ink/70">{g.body}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-plum">Open the reference →</span>
        </a>
      ))}
    </div>

    <div class="mt-14 rounded-3xl bg-plum px-8 py-12 text-center text-white">
      <h2 class="font-display text-2xl font-semibold">Or skip the charts entirely.</h2>
      <p class="mx-auto mt-3 max-w-md text-white/80">
        Attirel knows how every brand runs and matches sizes to your measurements automatically.
      </p>
      <a
        href="https://www.attirel.ai"
        class="mt-6 inline-block rounded-full bg-white px-8 py-3 font-semibold text-plum transition-opacity hover:opacity-90"
      >
        Try Attirel at attirel.ai →
      </a>
    </div>
  </section>
</Base>
