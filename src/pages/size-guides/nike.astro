---
import Base from '../../layouts/Base.astro';

const womens = [
  ['XS', '0–2', '4–6', '32–34', '30–32.5"', '24–26"', '33.5–35.5"'],
  ['S', '4–6', '8–10', '36–38', '32.5–35.5"', '26–29"', '35.5–38.5"'],
  ['M', '8–10', '12–14', '40–42', '35.5–38"', '29–32"', '38.5–41"'],
  ['L', '12–14', '16–18', '44–46', '38–41"', '32–35"', '41–44"'],
  ['XL', '16–18', '20–22', '48–50', '41–44.5"', '35–38.5"', '44–47"'],
];

const mens = [
  ['S', '35–37.5"', '29–32"', '35–37.5"'],
  ['M', '37.5–41"', '32–35"', '37.5–41"'],
  ['L', '41–44"', '35–38"', '41–44"'],
  ['XL', '44–48.5"', '38–43"', '44–47.5"'],
  ['XXL', '48.5–53.5"', '43–47.5"', '47.5–51"'],
];
---

<Base
  title="Nike Size Guide — Does Nike Run Small? (Charts & Tips) | Attirel"
  description="Nike runs about half a size small in shoes and slim in apparel. Full Nike size charts for women and men with US, UK, and EU conversions, plus fitting tips."
  ogType="article"
>
  <article class="mx-auto max-w-article px-5 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-plum">Size Guide</p>
    <h1 class="mt-2 font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
      Nike Size Guide
    </h1>

    <div class="mt-8 rounded-xl bg-plum-light p-5">
      <p class="font-semibold text-plum">Does Nike run small?</p>
      <p class="mt-2 text-ink/85">
        <strong>Yes — Nike runs about half a size small in footwear</strong>, especially in
        running shoes and Air Force 1s. Most people should size up half a size from their
        measured size. Apparel runs athletic and slim: if you’re between sizes or prefer a
        relaxed fit, size up.
      </p>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">Nike women’s apparel</h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-ink/10">
      <table class="w-full min-w-[640px] border-collapse bg-white/70 text-sm">
        <thead>
          <tr class="bg-plum text-left text-white">
            <th class="px-4 py-3 font-semibold">Size</th>
            <th class="px-4 py-3 font-semibold">US</th>
            <th class="px-4 py-3 font-semibold">UK</th>
            <th class="px-4 py-3 font-semibold">EU</th>
            <th class="px-4 py-3 font-semibold">Bust</th>
            <th class="px-4 py-3 font-semibold">Waist</th>
            <th class="px-4 py-3 font-semibold">Hips</th>
          </tr>
        </thead>
        <tbody>
          {womens.map((row) => (
            <tr class="border-t border-ink/10">
              {row.map((cell, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'font-semibold' : 'text-smoke'}`}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">Nike men’s apparel</h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-ink/10">
      <table class="w-full min-w-[480px] border-collapse bg-white/70 text-sm">
        <thead>
          <tr class="bg-plum text-left text-white">
            <th class="px-4 py-3 font-semibold">Size</th>
            <th class="px-4 py-3 font-semibold">Chest</th>
            <th class="px-4 py-3 font-semibold">Waist</th>
            <th class="px-4 py-3 font-semibold">Hips</th>
          </tr>
        </thead>
        <tbody>
          {mens.map((row) => (
            <tr class="border-t border-ink/10">
              {row.map((cell, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'font-semibold' : 'text-smoke'}`}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight">Conversion &amp; fitting tips</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-ink/85">
      <li><strong>Shoes:</strong> go up half a size from your true measured size; if you wear thick athletic socks, consider a full size up in running shoes.</li>
      <li><strong>Leggings and tights:</strong> Nike’s compression styles run especially snug — size up for a comfort fit, stay true for a compression fit.</li>
      <li><strong>UK vs US women’s apparel:</strong> UK sizes are numerically 4 higher (US 8 = UK 12).</li>
      <li><strong>Dri-FIT tops:</strong> designed with an athletic taper through the waist; broad-shouldered builds often prefer one size up.</li>
    </ul>

    <div class="mt-12 rounded-3xl bg-plum px-8 py-12 text-center text-white">
      <h2 class="font-display text-2xl font-semibold">Skip the mental math.</h2>
      <p class="mx-auto mt-3 max-w-md text-white/80">
        Attirel adjusts for Nike’s sizing automatically — your measurements in, the right Nike
        size out.
      </p>
      <a
        href="https://attirel.ai"
        class="mt-6 inline-block rounded-full bg-white px-8 py-3 font-semibold text-plum transition-opacity hover:opacity-90"
      >
        Try it at attirel.ai →
      </a>
    </div>
  </article>
</Base>
