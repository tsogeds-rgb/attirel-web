---
import BrandGuide from '../../components/BrandGuide.astro';
import AffLink from '../../components/AffLink.astro';
import type { ConversionTable } from '../../config/sizeConversions';

const charts: ConversionTable[] = [
  {
    heading: 'Nike women’s apparel',
    minWidth: 640,
    headers: ['Size', 'US', 'UK', 'EU', 'Bust', 'Waist', 'Hips'],
    rows: [
      ['XS', '0–2', '4–6', '32–34', '30–32.5"', '24–26"', '33.5–35.5"'],
      ['S', '4–6', '8–10', '36–38', '32.5–35.5"', '26–29"', '35.5–38.5"'],
      ['M', '8–10', '12–14', '40–42', '35.5–38"', '29–32"', '38.5–41"'],
      ['L', '12–14', '16–18', '44–46', '38–41"', '32–35"', '41–44"'],
      ['XL', '16–18', '20–22', '48–50', '41–44.5"', '35–38.5"', '44–47"'],
    ],
  },
  {
    heading: 'Nike men’s tops',
    note: 'Nike’s own chart lists hip equal to chest at XS through L, diverging only from XL upward; that is how Nike publishes it, not a transcription error. Tall sizes (S through 4XL, select styles) run 1.75" longer in the body with sleeves adjusted by silhouette; Tall bottoms add 2" of inseam and 0.5" of rise.',
    noteAfter: true,
    minWidth: 480,
    headers: ['Size', 'Chest', 'Waist', 'Hip'],
    rows: [
      ['XXS', '28.1–31.5"', '22.5–25.5"', '28.5–31.5"'],
      ['XS', '31.5–35"', '25.5–29"', '31.5–35"'],
      ['S', '35–37.5"', '29–32"', '35–37.5"'],
      ['M', '37.5–41"', '32–35"', '37.5–41"'],
      ['L', '41–44"', '35–38"', '41–44"'],
      ['XL', '44–48.5"', '38–43"', '44–47"'],
      ['XXL', '48.5–53.5"', '43–47.5"', '47–50.5"'],
      ['3XL', '53.5–58"', '47.5–52.5"', '50.5–53.5"'],
      ['4XL', '58–63"', '52.5–57"', '53.5–58.5"'],
    ],
  },
];
---

<BrandGuide
  brandKey="nike"
  brand="Nike"
  title="Nike Size Guide — Does Nike Run Small? (Charts & Tips) | Attirel"
  description="Nike runs about half a size small in shoes and slim in apparel. Full Nike size charts for women and men with US, UK, and EU conversions, plus fitting tips."
  h1="Nike Size Guide"
  standardCharts={false}
  typicalCharts={charts}
  fitSections={[]}
  faqs={[]}
  related={[]}
>
  <Fragment slot="verdict">
    <strong>Yes — Nike runs about half a size small in footwear</strong>, especially in running
    shoes and Air Force 1s. Most people should size up half a size from their measured size.
    Apparel runs athletic and slim: if you're between sizes or prefer a relaxed fit, size up.
  </Fragment>
  <Fragment slot="charts-intro">
    <p class="mt-3 leading-relaxed text-ink/85">
      The men's chart below is drawn from <AffLink
        brand="nike"
        href="https://www.nike.com/size-fit/mens_tops_alpha"
        >Nike's published tops chart</AffLink
      > (captured August 2026). The women's chart predates that verification and keeps its
      original figures pending the same check. Fit still varies between styles, so check the size
      chart on the product page before you order.
    </p>
  </Fragment>
  <Fragment slot="tips">
    <li><strong>Shoes:</strong> go up half a size from your true measured size; if you wear thick athletic socks, consider a full size up in running shoes.</li>
    <li><strong>Leggings and tights:</strong> Nike's compression styles run especially snug: size up for a comfort fit, stay true for a compression fit.</li>
    <li><strong>UK vs US women's apparel:</strong> UK sizes are numerically 4 higher (US 8 = UK 12).</li>
    <li><strong>Dri-FIT tops:</strong> designed with an athletic taper through the waist; broad-shouldered builds often prefer one size up.</li>
    <li><strong>Nike's own tie-breaker:</strong> when your chest and waist land in different sizes, Nike says to go by chest for tops and by hip for bottoms.</li>
  </Fragment>
</BrandGuide>
