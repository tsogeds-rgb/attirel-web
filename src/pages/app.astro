---
import Base from '../layouts/Base.astro';
import { brandNames, formatBrandList } from '../lib/supportedBrands';

const supported = formatBrandList(brandNames);
const supportedOr = formatBrandList(brandNames, 'or');
const count = brandNames.length;

const steps = [
  {
    n: '1',
    title: 'Measure',
    body: 'Chest, waist and hips with a tape measure, plus inseam and foot length if you want bottoms and shoes. Our measuring guide shows where each one goes. Five numbers, once.',
  },
  {
    n: '2',
    title: 'Check',
    body: `Enter them at attirel.ai/size-check — no account needed — and see your size at ${supported}, read from each brand's own published chart. Nothing is estimated.`,
  },
  {
    n: '3',
    title: 'Save',
    body: 'Create a free account to keep your measurements. Each time we verify a new brand, your size at it is waiting the next time you sign in. Edit any number later and every result updates.',
  },
];

const labels = [
  {
    label: 'Fits',
    color: 'bg-green-100 text-green-800 border-green-200',
    body: 'Every measurement is within what your chosen fit (snug, regular or relaxed) allows. Buy the size shown.',
  },
  {
    label: 'Fits, with a note',
    color: 'bg-amber-100 text-amber-800 border-amber-200',
    body: 'It fits where it matters, but one measurement is well off the chart figure — roomy through the waist on a top, say. The card tells you which, and by how much.',
  },
  {
    label: 'Probably won’t fit',
    color: 'bg-red-100 text-red-800 border-red-200',
    body: 'You are bigger than the garment somewhere by more than your fit preference allows. The card names the closest size and what it would cost you.',
  },
];

const inApp = [
  ['Categories', 'Tops, bottoms, dresses, outerwear and shoes, wherever the brand publishes a chart for them. Men’s and women’s.'],
  ['The numbers beside yours', 'Every result shows your measurement and the chart’s figure for that size side by side — “You 29″ · Size 8 29″” — so you can check the arithmetic against the brand’s own page.'],
  ['Between sizes, said plainly', 'When your waist lands on one size and your chest on another, the card says so and tells you which one decides, instead of hiding it behind a single number.'],
  ['Chart dates', 'Each result says when we transcribed that brand’s chart. Brands change charts; we re-check and update the date.'],
];

const notYet = [
  ['Shoe widths', 'We check foot length. Wide and extra-wide fittings are described in the brand guides but not yet scored.'],
  ['Bras', 'No band or cup checks yet. Brands that publish bra charts are on the list.'],
  ['Shopping', 'Attirel tells you your size. It doesn’t sell clothes, compare prices or show products.'],
];
---

<Base
  title="How Attirel Works: Your Size from the Brand's Own Chart"
  description={`Enter your measurements once and see your size at ${supported}, read from each brand's own published size chart. What the app does, what a result means, and what it doesn't do yet.`}
>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-16 text-center">
    <h1 class="mx-auto max-w-3xl font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
      Enter your measurements once. See your size at every brand we’ve verified.
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-smoke">
      Attirel compares your measurements to each brand’s own published size chart — the exact
      numbers, not an estimate. {count} brands today: {supported}.
    </p>
  </section>

  <!-- 3 steps -->
  <section class="border-y border-ink/10 bg-white/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-3">
      {steps.map((s) => (
        <div>
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-plum font-display text-lg font-semibold text-white">
            {s.n}
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold">{s.title}</h2>
          <p class="mt-2 text-smoke">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- What a result means -->
  <section class="mx-auto max-w-article px-5 py-16">
    <h2 class="font-display text-3xl font-semibold tracking-tight">What a result means</h2>
    <p class="mt-3 text-smoke">
      Every card gives you a size, one sentence on why, and each measurement in words —
      <em>exact</em>, <em>roomy</em>, <em>snug</em> or <em>tight</em> — with the brand’s chart
      figure beside yours. The label at the top is one of three:
    </p>
    <div class="mt-8 flex flex-col gap-4">
      {labels.map((l) => (
        <div class={`rounded-xl border p-5 ${l.color}`}>
          <p class="font-semibold">{l.label}</p>
          <p class="mt-1 text-sm opacity-90">{l.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-smoke">
      A brand with no size for your measurements is told to you as such. We don’t round you
      into one.
    </p>
  </section>

  <!-- In the app / not yet -->
  <section class="border-y border-ink/10 bg-white/60">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="font-display text-3xl font-semibold tracking-tight">In the app today</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {inApp.map(([title, body]) => (
          <div class="rounded-2xl bg-cream p-6">
            <h3 class="font-semibold text-plum">{title}</h3>
            <p class="mt-2 text-sm text-smoke">{body}</p>
          </div>
        ))}
      </div>
      <h2 class="mt-14 font-display text-2xl font-semibold tracking-tight">Not yet</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {notYet.map(([title, body]) => (
          <div class="rounded-2xl border border-ink/10 p-6">
            <h3 class="font-semibold">{title}</h3>
            <p class="mt-2 text-sm text-smoke">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-16 text-center">
    <h2 class="font-display text-3xl font-semibold tracking-tight">
      Shopping {supportedOr}?
    </h2>
    <a
      href="https://attirel.ai/size-check"
      data-app-cta="how_it_works"
      class="mt-6 inline-block rounded-full bg-plum px-8 py-3.5 font-semibold text-white transition-colors hover:bg-plum-dark"
    >
      Check your size — no account needed
    </a>
  </section>
</Base>
